# Malli tiedostosta keystore.properties, joka EI ole versiossa (gitignore).
# Kopioi tama nimelle keystore.properties ja tayta omilla arvoillasi.
#
# storeFile osoittaa avainvarastoon, joka pidetaan REPON ULKOPUOLELLA. Nain vahingossa
# annettu "git add ." ei voi lisata sita. Polku saa olla absoluuttinen.
#
# Avaimen katoaminen on peruuttamatonta: ilman sita sovellusta ei voi enaa paivittaa,
# ei omalla laitteella eika kaupassa. Varmuuskopioi seka .jks-tiedosto etta salasanat
# paikkaan joka ei ole tama kone.

storeFile=C:/Users/nimi/Documents/avaimet/dg-android-julkaisu.jks
storePassword=
keyAlias=dg-android
keyPassword=
